<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 只需要联网（调 Jev）与通知（常驻入口，可关） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".JevApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.JevGuide">

        <!--
          首页：桌面入口。只回答「你想干什么」，把设置拆成五个入口，
          点进去带 section 参数打开设置页并滚到那一分区（不复制任何设置逻辑）。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设置页：从首页各入口进来（带 section 参数定位到分区） -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!--
          结果页：浮在微信上面的一层（攻略度 + 候选文案），关掉就回聊天。

          launchMode 必须是 singleInstance：判读可以连着来好几次，而结果页是对话框样式，
          singleTop 在"服务用 NEW_TASK 拉起"这条路径上挡不住叠加 —— 实测屏幕上会同时挂着
          4 个 ResultActivity 窗口（用户反馈"怎么有两个浮窗"）。singleInstance 全系统只有一个实例，
          新的一次判读走 onNewIntent 复用同一个窗口。
        -->
        <activity
            android:name=".ResultActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.JevGuide.Dialog" />

        <!-- 无障碍服务：只订阅微信 -->
        <service
            android:name=".WatchService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/a11y_config" />
        </service>

        <!-- 分享记忆文件用：把外部私有目录里的 json 通过 content:// 发给别的 App -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 常驻通知上"判读一下"按钮的落地 -->
        <receiver
            android:name=".AnalyzeReceiver"
            android:exported="false" />

        <!-- 快捷设置磁贴：下拉栏点一下判读一次 -->
        <service
            android:name=".TileTrigger"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
