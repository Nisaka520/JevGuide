<?xml version="1.0" encoding="utf-8"?>
<!--
  图标前景：一个**描边**的聊天气泡 + 里面一个向上的箭头（自绘矢量，非任何现成素材）。

  几何约束（最容易翻车的地方）：自适应图标的 viewport 是 108×108，但系统遮罩会裁掉四周，
  真正保证可见的只有**中间 66×66**（即 21…87）。所以这里所有内容都收在 24…84 × 26…80 里，
  比安全区再留一点余量 —— 各家 ROM 的圆角/方形遮罩半径不一样，贴边画必被切。

  为什么用描边而不是实心：单色层（monochrome）只能用一种颜色，实心气泡里就"挖"不出箭头；
  描边气泡 + 实心箭头在任何单色渲染下都能看清结构。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 气泡主体：圆角矩形 (24,26)-(84,70)，圆角 12 -->
    <path
        android:pathData="M36,26 H72 A12,12 0 0 1 84,38 V58 A12,12 0 0 1 72,70 H36 A12,12 0 0 1 24,58 V38 A12,12 0 0 1 36,26 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineJoin="round"
        android:strokeWidth="5" />

    <!-- 气泡尾巴：从底边往左下折一下（描边 + 圆角连接，看起来是连着的） -->
    <path
        android:pathData="M40,70 V80 L54,70"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="5" />

    <!-- 上升箭头：实心三角头 + 竖杆（= 攻略度在涨） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,36 L62,46 L46,46 Z" />
    <path
        android:pathData="M54,46 V62"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />
</vector>
