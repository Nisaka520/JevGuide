<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷设置磁贴图标（下拉通知栏那个方块的图标）。

  ⚠ 磁贴图标必须是**纯单色 + 24dp**：系统只取 alpha 通道，自己上色（亮的时候用主色）。
  所以这里跟 App 图标用同一套造型（气泡 + 上升箭头），但尺寸缩到 24 并且只留白。

  几何从 108 的 App 图标按 24/108 缩下来，略作圆整（保留 0.5 精度，避免描边糊成一团）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 气泡主体 -->
    <path
        android:pathData="M8,6 H16 A2.5,2.5 0 0 1 18.5,8.5 V13.5 A2.5,2.5 0 0 1 16,16 H8 A2.5,2.5 0 0 1 5.5,13.5 V8.5 A2.5,2.5 0 0 1 8,6 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineJoin="round"
        android:strokeWidth="1.6" />

    <!-- 气泡尾巴 -->
    <path
        android:pathData="M8.5,16 V19.5 L12,16"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.6" />

    <!-- 上升箭头 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,8 L14.2,10.8 L9.8,10.8 Z" />
    <path
        android:pathData="M12,10.8 V14.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />
</vector>
