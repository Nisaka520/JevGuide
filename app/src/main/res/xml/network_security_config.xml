<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：默认只允许 HTTPS，只为本机/模拟器调试端点开明文例外。

  为什么需要它：targetSdk ≥ 28 时 Android 默认禁止明文 HTTP。调试本机假端点
  （127.0.0.1 / 10.0.2.2）确实只有 http，放开这一小片；其余一律 https。

  为什么不做成"全局放开"：那等于对所有连接都关掉这道保护。这里只放白名单，
  公网服务（DeepSeek / OpenAI 等）仍然必须走 HTTPS —— 密钥不该在明文里裸奔。
  主人换了服务器就改这里，或者干脆用带证书的域名。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- v1.4.1 起不再放行任何公网 IP 的明文：http 端点=密钥与聊天内容裸奔给中间人。
             自建网关请配证书走 https，这里只剩本机调试例外。 -->
        <!-- 本机调试（比如在电脑上跑个假的 OpenAI 端点） -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
