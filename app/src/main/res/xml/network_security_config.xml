<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：默认只允许 HTTPS，只为**自建的 OpenAI 兼容端点**按 IP 开明文例外。

  为什么需要它：targetSdk ≥ 28 时 Android 默认禁止明文 HTTP，而自建/自托管的网关
  （比如 n4 上的 aurora、n1 上的中转站）往往只有 HTTP，没有证书。不放开的话，
  聊天模型那一栏填 http://… 会直接连不上，而且报错很难懂（CLEARTEXT communication not permitted）。

  为什么不做成"全局放开"：那等于对所有连接都关掉这道保护。这里只放白名单，
  公网服务（DeepSeek / OpenAI 等）仍然必须走 HTTPS —— 密钥不该在明文里裸奔。
  主人换了服务器就改这里，或者干脆用带证书的域名。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- 自建节点：n4（aurora 直连 / chat2api）、n1（中转站） -->
        <domain includeSubdomains="false">23.251.34.187</domain>
        <domain includeSubdomains="false">103.36.222.172</domain>
        <!-- 本机调试（比如在电脑上跑个假的 OpenAI 端点） -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
